{
  "name": "ai-system-hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Мета-агент на Claude, який створює та керує під-агентами з різними персонами.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json && node -e \"require('fs').cpSync('src/web','dist/web',{recursive:true})\"",
    "serve": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.102.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
