# Скопіюй цей файл у .env і впиши свій ключ:  cp .env.example .env
# Файл .env у .gitignore — він НЕ потрапить у git.

# Ключ Anthropic API (беруть на console.anthropic.com → API Keys).
# Без нього система працює в демо-режимі (мок).
ANTHROPIC_API_KEY=sk-ant-...

# --- Необов'язкові налаштування (можна не чіпати) ---
# Модель Claude:
# AI_HUB_MODEL=claude-opus-4-8
# Порт веб-сервера:
# PORT=4317
# Примусовий мок-режим навіть із ключем (1 — увімкнути):
# AI_HUB_MOCK=1
# Максимум токенів на відповідь:
# AI_HUB_MAX_TOKENS=4096
